{
  "manifest_version": 3,
  "name": "SentinelAI",
  "version": "1.0.0",
  "description": "Security-focused browser extension for detecting suspicious web activity.",

  "permissions": [
    "storage",
    "tabs"
  ],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
            "content/url-security.js",
            "content/dom-security.js",
            "content/form-security.js",
            "content/script-iframe-security.js",
            "content/sensitive-data-security.js",
            "content/phishing-security.js",
            "content/content.js"
        ],
      "run_at": "document_idle"
    }
  ]
}